# Default text handling
* text=auto

# Source and documentation should remain review-friendly.
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# PowerShell scripts are commonly edited on Windows.
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.docx binary
*.ppt binary
*.pptx binary
*.pkl binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
